---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { formatPrice, getConfig } from '../../../config';
import { listAllProducts, countAllProducts } from '../../../features/products/db';
import ProductImage from '../../../features/products/ProductImage.astro';
import { orderByClause } from '../../../features/products/sort';
import { paginate, queryHref } from '../../../pagination';
import Pagination from '../../../components/Pagination.astro';
import { menuReferencesFor } from '../../../features/navigation/admin';
import FilterBar from '../../../components/FilterBar.astro';
import {
  parseProductFilters,
  productFilterClause,
  productFilterParams,
  hasProductFilters,
  productStatusOptions,
  productStockOptions,
} from '../../../features/products/filter';

const { t, intl } = Astro.locals.i18n;
const currency = getConfig().currency;
// confirm() receives the message inside a single-quoted JS string in an
// attribute, so a translation's apostrophe must not end that string.
const jsString = (s: string) => s.replace(/\\/g, '\\\\').replace(/'/g, "\\'");

// Auth: /admin + /api/admin are gated by src/middleware.ts. The admin password is
// set in the first-run setup wizard (hashed in D1); Cloudflare Access at the edge
// is the recommended production layer — see README → Admin auth.

const sort = Astro.url.searchParams.get('sort');
const dir = Astro.url.searchParams.get('dir');
const order = orderByClause(sort, dir);

const filters = parseProductFilters(Astro.url.searchParams);
// One clause, both queries — otherwise the pager counts rows the table filtered out.
const filterClause = productFilterClause(filters);
const filtered = hasProductFilters(filters);

const PAGE_SIZE = 30;
const matchCount = await countAllProducts(env.DB, filterClause);
const { page, offset, totalPages } = paginate(
  Astro.url.searchParams,
  matchCount,
  PAGE_SIZE,
);
const products = await listAllProducts(env.DB, PAGE_SIZE, offset, order, filterClause);
// Bounded to this page of rows, so the nav warning costs one query, not one
// per product.
const menuRefs = await menuReferencesFor(env.DB, 'product', products.map((p) => p.id));
// Sort and pagination links carry the active filters, so paging or re-sorting
// a filtered list doesn't silently drop back to everything.
const filterQuery = productFilterParams(filters);
const hrefFor = (p: number) =>
  queryHref('/admin/products', { ...filterQuery, sort, dir, page: p > 1 ? p : undefined });

// Column header → sort by it, toggling direction (default asc on a new column).
const sortHref = (col: string) =>
  queryHref('/admin/products', {
    ...filterQuery,
    sort: col,
    dir: sort === col && dir === 'asc' ? 'desc' : 'asc',
  });
const arrow = (col: string) => (sort === col ? (dir === 'asc' ? ' ↑' : ' ↓') : '');
---

<AdminLayout title={t('adminProducts.list.title')} active="products">
  <div class="mb-8 flex items-center justify-between">
    <h1 class="font-serif text-3xl tracking-tight">{t('adminProducts.list.title')}</h1>
    <a
      href="/admin/products/new"
      class="rounded-md bg-brand px-4 py-2 text-xs font-medium uppercase tracking-wider text-white hover:bg-brand-hover"
    >
      {t('adminProducts.list.newProduct')}
    </a>
  </div>

  <FilterBar
    action="/admin/products"
    active={filtered}
    count={matchCount}
    countLabel={t('adminProducts.list.matchCount', { count: matchCount })}
    hidden={{ sort: sort ?? undefined, dir: dir ?? undefined }}
    search={{ name: 'q', value: filters.q, placeholder: t('adminProducts.list.searchPlaceholder') }}
    selects={[
      {
        name: 'status',
        label: t('adminProducts.list.visibility'),
        anyLabel: t('adminProducts.list.allProducts'),
        value: filters.status,
        options: productStatusOptions(Astro.locals.i18n),
      },
      {
        name: 'stock',
        label: t('adminProducts.list.stock'),
        anyLabel: t('adminProducts.list.anyStock'),
        value: filters.stock,
        options: productStockOptions(Astro.locals.i18n),
      },
    ]}
  />

  <div class="sm:overflow-x-auto">
    <table class="admin-table w-full text-left text-sm sm:min-w-[42rem]">
    <thead>
      <tr class="border-b border-line text-xs uppercase tracking-widest text-gray-400">
        <th class="py-3 pr-4 font-normal">
          <a href={sortHref('name')} class="hover:text-brand">{t('adminProducts.list.colProduct')}{arrow('name')}</a>
        </th>
        <th class="py-3 pr-4 font-normal">
          <a href={sortHref('price')} class="hover:text-brand">{t('adminProducts.list.colPrice')}{arrow('price')}</a>
        </th>
        <th class="py-3 pr-4 font-normal">
          <a href={sortHref('stock')} class="hover:text-brand">{t('adminProducts.list.colStock')}{arrow('stock')}</a>
        </th>
        <th class="py-3 pr-4 font-normal">
          <a href={sortHref('sold')} class="hover:text-brand">{t('adminProducts.list.colSold')}{arrow('sold')}</a>
        </th>
        <th class="py-3 pr-4 font-normal">
          <a href={sortHref('active')} class="hover:text-brand">{t('adminProducts.list.colActive')}{arrow('active')}</a>
        </th>
        <th class="py-3 text-right font-normal">{t('adminProducts.list.colActions')}</th>
      </tr>
    </thead>
    <tbody>
      {
        products.map((p) => (
          <tr class="border-b border-line">
            <td class="py-3 pr-4">
              <a
                href={`/admin/products/${p.public_id}/edit`}
                class="flex items-center gap-3 hover:text-brand"
              >
                <ProductImage
                  imageKey={p.image_key}
                  alt=""
                  usage="thumbnail"
                  class="h-10 w-10 rounded object-cover"
                />
                <span class="font-medium">{p.name}</span>
              </a>
            </td>
            <td data-label={t('adminProducts.list.colPrice')} class="py-3 pr-4 tabular-nums">
              {formatPrice(p.price_cents, currency, intl)}
            </td>
            <td data-label={t('adminProducts.list.colStock')} class="py-3 pr-4 tabular-nums">{p.stock}</td>
            <td data-label={t('adminProducts.list.colSold')} class="py-3 pr-4 tabular-nums">
              {p.sold > 0 ? p.sold : <span class="text-gray-300">0</span>}
            </td>
            <td data-label={t('adminProducts.list.colActive')} class="py-3 pr-4">
              {p.active ? (
                t('adminProducts.list.yes')
              ) : (
                <span class="text-gray-400">{t('adminProducts.list.no')}</span>
              )}
            </td>
            <td data-label="" class="py-3 text-right">
              <div class="flex justify-end gap-4 text-xs uppercase tracking-widest">
                <a
                  href={`/products/${p.slug}`}
                  target="_blank"
                  rel="noopener"
                  class="text-gray-500 hover:text-brand"
                >
                  {t('adminProducts.list.view')} ↗
                </a>
                <a href={`/admin/products/${p.public_id}/edit`} class="text-accent hover:underline">
                  {t('adminProducts.list.edit')}
                </a>
                <form
                  method="POST"
                  action={`/api/admin/products/${p.public_id}`}
                  onsubmit={`return confirm('${jsString(
                    menuRefs.has(p.id)
                      ? t('adminProducts.list.confirmDeleteLinked')
                      : t('adminProducts.list.confirmDelete'),
                  )}')`}
                >
                  <input type="hidden" name="_action" value="delete" />
                  <button type="submit" class="text-red-600 hover:underline">
                    {t('adminProducts.list.delete')}
                  </button>
                </form>
              </div>
            </td>
          </tr>
        ))
      }
      {
        products.length === 0 && (
          <tr>
            <td colspan="6" class="py-8 text-center text-gray-400">
              {/* "No products yet" would be wrong — and confusing — when the
                  store has plenty and the filter simply excluded them all. */}
              {filtered ? t('adminProducts.list.noMatches') : t('adminProducts.list.empty')}
            </td>
          </tr>
        )
      }
    </tbody>
    </table>
  </div>

  <Pagination page={page} totalPages={totalPages} hrefFor={hrefFor} />
</AdminLayout>
