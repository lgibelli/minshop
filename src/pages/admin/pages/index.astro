---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { listPages } from '../../../features/pages/db';
import { menuReferencesFor } from '../../../features/navigation/admin';

const pages = await listPages(env.DB);
// Deleting a page that a menu links to silently shrinks the storefront nav.
// One bounded query for the whole list, so say so before it happens.
const menuRefs = await menuReferencesFor(
  env.DB,
  'page',
  pages.map((p) => p.id),
);
const { t, th, intl } = Astro.locals.i18n;
const dateFmt = new Intl.DateTimeFormat(intl, { dateStyle: 'medium' });
const formatDate = (iso: string) => dateFmt.format(new Date(`${iso.replace(' ', 'T')}Z`));
// Messages land inside single-quoted JS strings in inline confirm() handlers.
const jsQuote = (s: string) => s.replace(/[\\']/g, '\\$&');
---

<AdminLayout title={t('adminContent.pages.title')} active="pages">
  <div class="mb-8 flex items-center justify-between">
    <h1 class="font-serif text-3xl tracking-tight">{t('adminContent.pages.title')}</h1>
    <a
      href="/admin/pages/new"
      class="rounded-md bg-brand px-4 py-2 text-xs font-medium uppercase tracking-wider text-white hover:bg-brand-hover"
    >
      {t('adminContent.pages.newPage')}
    </a>
  </div>

  {
    pages.length === 0 ? (
      <p class="py-12 text-center text-sm text-gray-500">
        <Fragment set:html={th('adminContent.pages.empty', { href: '/admin/navigation' })} />
      </p>
    ) : (
      <div class="sm:overflow-x-auto">
        <table class="admin-table w-full text-left text-sm sm:min-w-[40rem]">
          <thead>
            <tr class="border-b border-line text-xs uppercase tracking-widest text-gray-400">
              <th class="py-3 pr-4 font-normal">{t('adminContent.pages.colTitle')}</th>
              <th class="py-3 pr-4 font-normal">{t('adminContent.pages.colUrl')}</th>
              <th class="py-3 pr-4 font-normal">{t('adminContent.pages.colStatus')}</th>
              <th class="py-3 pr-4 font-normal">{t('adminContent.pages.colUpdated')}</th>
              <th class="py-3 text-right font-normal">{t('adminContent.pages.colActions')}</th>
            </tr>
          </thead>
          <tbody>
            {pages.map((page) => (
              <tr class="border-b border-line">
                <td class="py-3 pr-4">
                  <a href={`/admin/pages/${page.public_id}/edit`} class="font-medium hover:text-brand">
                    {page.title}
                  </a>
                </td>
                <td data-label={t('adminContent.pages.colUrl')} class="py-3 pr-4 text-gray-500">/pages/{page.slug}</td>
                <td data-label={t('adminContent.pages.colStatus')} class="py-3 pr-4">
                  {page.published ? (
                    <span class="text-gray-600">{t('adminContent.pages.published')}</span>
                  ) : (
                    <span class="text-gray-400">{t('adminContent.pages.draft')}</span>
                  )}
                </td>
                <td data-label={t('adminContent.pages.colUpdated')} class="py-3 pr-4 text-gray-500">
                  {formatDate(page.updated_at)}
                </td>
                <td class="py-3 text-right">
                  <span class="inline-flex items-center gap-3">
                    {page.published !== 0 && (
                      <a
                        href={`/pages/${page.slug}`}
                        target="_blank"
                        rel="noopener"
                        class="text-xs uppercase tracking-widest text-gray-500 hover:text-brand"
                      >
                        {t('adminContent.pages.view')}
                      </a>
                    )}
                    <a
                      href={`/admin/pages/${page.public_id}/edit`}
                      class="text-xs uppercase tracking-widest text-gray-500 hover:text-brand"
                    >
                      {t('adminContent.pages.edit')}
                    </a>
                    <form
                      method="POST"
                      action={`/api/admin/pages/${page.public_id}`}
                      onsubmit={`return confirm('${jsQuote(
                        menuRefs.has(page.id)
                          ? t('adminContent.pages.deleteLinkedConfirm')
                          : t('adminContent.pages.deleteConfirm'),
                      )}')`}
                    >
                      <input type="hidden" name="_action" value="delete" />
                      <button
                        type="submit"
                        class="text-xs uppercase tracking-widest text-red-600 hover:text-red-700"
                      >
                        {t('adminContent.pages.delete')}
                      </button>
                    </form>
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</AdminLayout>
