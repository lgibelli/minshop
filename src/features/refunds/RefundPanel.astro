---
import { formatPrice, formatDate } from '../../config';
import type { Order } from '../orders/db';
import { listRefunds, reversedRefundIds, refundableCents } from './db';
import { env } from 'cloudflare:workers';
import type { MessageKey } from '../../i18n';

interface Props {
  order: Order;
  timeZone: string;
}

const { order, timeZone } = Astro.props;
const { t, th, intl } = Astro.locals.i18n;
// Messages land inside single-quoted JS strings in inline confirm() handlers.
const jsQuote = (s: string) => s.replace(/[\\']/g, '\\$&');

const history = await listRefunds(env.DB, order.id);
const reversed = reversedRefundIds(history);
const remaining = refundableCents(order);
const method = order.payment_method;

// Which controls make sense depends on what the rail can actually do, not on
// what minshop would like it to do. Only Stripe can be refunded through an API;
// everything else is money the merchant moved themselves and is telling us about.
const canRefundViaProvider =
  (method === 'stripe' || method == null) &&
  !!order.provider_session_id &&
  remaining > 0 &&
  order.external_refunded_cents === 0;
const canSyncProvider = (method === 'stripe' || method == null) && remaining > 0;
const isDemo = method === 'demo';
const canRecord = remaining > 0;

// Partial is derived, never stored: it is simply "some, but not all".
const state =
  order.refunded_cents === 0
    ? 'none'
    : order.refunded_cents >= order.amount_total_cents
      ? 'full'
      : 'partial';

const reviewOpen = order.refund_review_reason !== null && order.refund_reviewed_at === null;
// Review reasons and ledger kinds are stored codes; unknown ones show as-is.
const REVIEW_COPY: Record<string, MessageKey> = {
  currency_mismatch: 'adminOrders.refunds.reviewCurrencyMismatch',
  exceeds_order_total: 'adminOrders.refunds.reviewExceedsTotal',
};
const reviewCopy = (reason: string) =>
  Object.hasOwn(REVIEW_COPY, reason) ? t(REVIEW_COPY[reason]) : reason;

const KIND_LABEL: Record<string, MessageKey> = {
  provider_api: 'adminOrders.refunds.kindProviderApi',
  provider_sync: 'adminOrders.refunds.kindProviderSync',
  manual_external: 'adminOrders.refunds.kindManualExternal',
  manual_reversal: 'adminOrders.refunds.kindManualReversal',
  demo: 'adminOrders.refunds.kindDemo',
  legacy: 'adminOrders.refunds.kindLegacy',
};
const kindLabel = (kind: string) => (Object.hasOwn(KIND_LABEL, kind) ? t(KIND_LABEL[kind]) : kind);
const remainingLabel = formatPrice(remaining, order.currency, intl);

const dollars = (cents: number) => (cents / 100).toFixed(2);
---

<section class="mb-8 rounded-lg border border-line">
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-line px-5 py-3">
    <h2 class="font-serif text-lg tracking-tight">{t('adminOrders.refunds.title')}</h2>
    {
      state !== 'none' && (
        <span
          class:list={[
            'rounded-full px-3 py-1 text-xs uppercase tracking-wide ring-1',
            state === 'full'
              ? 'bg-red-50 text-red-700 ring-red-200'
              : 'bg-amber-50 text-amber-800 ring-amber-200',
          ]}
        >
          {state === 'full' ? t('adminOrders.refunds.stateFull') : t('adminOrders.refunds.statePartial')}
        </span>
      )
    }
  </div>

  {
    reviewOpen && (
      <div class="border-b border-line bg-amber-50 px-5 py-4">
        <p class="text-sm text-amber-900">
          <strong>{t('adminOrders.refunds.needsReview')}</strong>{' '}
          {reviewCopy(order.refund_review_reason!)}
        </p>
        <form method="POST" action={`/api/admin/orders/${order.public_id}`} class="mt-3">
          <input type="hidden" name="_action" value="review_refund" />
          <button
            type="submit"
            class="rounded-md border border-amber-300 bg-surface px-3 py-1.5 text-xs font-medium uppercase tracking-wider text-amber-900 hover:bg-amber-100"
          >
            {t('adminOrders.refunds.markReviewed')}
          </button>
        </form>
      </div>
    )
  }

  <dl class="grid grid-cols-2 gap-x-8 gap-y-3 px-5 py-4 text-sm sm:grid-cols-3">
    <div>
      <dt class="text-xs uppercase tracking-widest text-faint">{t('adminOrders.refunds.orderTotal')}</dt>
      <dd class="tabular-nums">{formatPrice(order.amount_total_cents, order.currency, intl)}</dd>
    </div>
    {
      order.provider_refunded_cents > 0 && (
        <div>
          <dt class="text-xs uppercase tracking-widest text-faint">{t('adminOrders.refunds.throughProvider')}</dt>
          <dd class="tabular-nums">
            {formatPrice(order.provider_refunded_cents, order.currency, intl)}
          </dd>
        </div>
      )
    }
    {
      order.external_refunded_cents > 0 && (
        <div>
          <dt class="text-xs uppercase tracking-widest text-faint">{t('adminOrders.refunds.recordedByHand')}</dt>
          <dd class="tabular-nums">
            {formatPrice(order.external_refunded_cents, order.currency, intl)}
          </dd>
        </div>
      )
    }
    <div>
      <dt class="text-xs uppercase tracking-widest text-faint">{t('adminOrders.refunds.totalRefunded')}</dt>
      <dd class="font-medium tabular-nums">{formatPrice(order.refunded_cents, order.currency, intl)}</dd>
    </div>
    <div>
      <dt class="text-xs uppercase tracking-widest text-faint">{t('adminOrders.refunds.refundableLeft')}</dt>
      <dd class="tabular-nums">{remainingLabel}</dd>
    </div>
    <div>
      <dt class="text-xs uppercase tracking-widest text-faint">{t('adminOrders.refunds.net')}</dt>
      <dd class="font-medium tabular-nums">
        {formatPrice(order.amount_total_cents - order.refunded_cents, order.currency, intl)}
      </dd>
    </div>
  </dl>

  {
    history.length > 0 && (
      <ul class="border-t border-line text-sm">
        {history.map((r) => (
          <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-line px-5 py-3 last:border-b-0">
            <span
              class:list={[
                'tabular-nums font-medium',
                r.amount_cents < 0 ? 'text-muted' : '',
                reversed.has(r.id) ? 'text-faint line-through' : '',
              ]}
            >
              {r.amount_cents < 0 ? '−' : ''}
              {formatPrice(Math.abs(r.amount_cents), order.currency, intl)}
            </span>
            <span class="text-xs uppercase tracking-widest text-faint">
              {kindLabel(r.kind)}
            </span>
            <span class="text-xs text-muted">{formatDate(r.created_at, undefined, timeZone, intl)}</span>
            {r.created_by && <span class="text-xs text-muted">{r.created_by}</span>}
            {r.provider_refund_id && (
              <span class="font-mono text-xs text-faint">{r.provider_refund_id}</span>
            )}
            {reversed.has(r.id) && (
              <span class="text-xs uppercase tracking-widest text-faint">{t('adminOrders.refunds.voided')}</span>
            )}
            <span class="w-full text-xs text-muted">
              {[r.reason, r.note].filter(Boolean).join(' — ')}
            </span>
            {/* Only entries minshop invented can be corrected here. A provider's
                own numbers belong to the provider, so they are reconciled rather
                than edited. */}
            {(r.kind === 'manual_external' || r.kind === 'demo') &&
              r.status === 'succeeded' &&
              !reversed.has(r.id) && (
                <form
                  method="POST"
                  action={`/api/admin/orders/${order.public_id}`}
                  onsubmit={`return confirm('${jsQuote(t('adminOrders.refunds.voidConfirm'))}')`}
                >
                  <input type="hidden" name="_action" value="void_refund" />
                  <input type="hidden" name="refund_id" value={r.public_id} />
                  <button
                    type="submit"
                    class="text-xs uppercase tracking-widest text-faint hover:text-red-600"
                  >
                    {t('adminOrders.refunds.void')}
                  </button>
                </form>
              )}
          </li>
        ))}
      </ul>
    )
  }

  {
    (canRefundViaProvider || canRecord || canSyncProvider) && (
      <div class="space-y-5 border-t border-line px-5 py-4">
        {/* The one control here that moves money is styled as the only one that
            does. Everything else is bookkeeping and says so in its own copy. */}
        {canRefundViaProvider && (
          <form
            method="POST"
            action={`/api/admin/orders/${order.public_id}`}
            onsubmit={`return confirm('${jsQuote(t('adminOrders.refunds.refundConfirm', { amount: remainingLabel }))}')`}
          >
            <input type="hidden" name="_action" value="refund" />
            {/* `remaining`, not the order total: the provider refunds only what
                is left, so after a partial refund made at the provider the
                original total would overstate what this button actually sends. */}
            <button
              type="submit"
              class="rounded-md bg-red-600 px-4 py-2 text-xs font-medium uppercase tracking-wider text-white hover:bg-red-700"
            >
              {t('adminOrders.refunds.refundButton', { amount: remainingLabel })}
            </button>
            <p class="mt-2 text-xs text-muted">
              {t('adminOrders.refunds.refundHelp')}
            </p>
          </form>
        )}

        {canRecord && (
          <form method="POST" action={`/api/admin/orders/${order.public_id}`} class="space-y-2">
            <input type="hidden" name="_action" value="record_refund" />
            <p class="text-xs uppercase tracking-widest text-faint">
              {isDemo ? t('adminOrders.refunds.recordDemoTitle') : t('adminOrders.refunds.recordTitle')}
            </p>
            <div class="flex flex-wrap items-center gap-2">
              <input
                type="number"
                name="amount"
                step="0.01"
                min="0.01"
                max={dollars(remaining)}
                value={dollars(remaining)}
                required
                aria-label={t('adminOrders.refunds.amountLabel')}
                class="w-28 rounded-md border border-line px-2 py-1.5 text-sm tabular-nums"
              />
              <input
                type="text"
                name="note"
                placeholder={t('adminOrders.refunds.notePlaceholder')}
                aria-label={t('adminOrders.refunds.noteLabel')}
                class="min-w-48 flex-1 rounded-md border border-line px-2 py-1.5 text-sm"
              />
              <button
                type="submit"
                class="rounded-md border border-line px-4 py-2 text-xs font-medium uppercase tracking-wider text-muted hover:border-brand"
              >
                {isDemo ? t('adminOrders.refunds.markRefunded') : t('adminOrders.refunds.recordRefund')}
              </button>
            </div>
            <p class="text-xs text-muted">
              {isDemo
                ? t('adminOrders.refunds.recordDemoHelp')
                : t('adminOrders.refunds.recordHelp')}
            </p>
          </form>
        )}

        {canSyncProvider && (
          <form method="POST" action={`/api/admin/orders/${order.public_id}`} class="space-y-2">
            <input type="hidden" name="_action" value="sync_refund" />
            <p class="text-xs uppercase tracking-widest text-faint">
              {t('adminOrders.refunds.syncTitle')}
            </p>
            <div class="flex flex-wrap items-center gap-2">
              <input
                type="number"
                name="amount"
                step="0.01"
                min="0"
                max={dollars(order.amount_total_cents)}
                required
                aria-label={t('adminOrders.refunds.syncAmountLabel')}
                placeholder={dollars(order.amount_total_cents)}
                class="w-28 rounded-md border border-line px-2 py-1.5 text-sm tabular-nums"
              />
              <input
                type="text"
                name="provider_refund_id"
                placeholder={t('adminOrders.refunds.providerRefundIdPlaceholder')}
                aria-label={t('adminOrders.refunds.providerRefundIdLabel')}
                class="min-w-48 flex-1 rounded-md border border-line px-2 py-1.5 text-sm"
              />
              <button
                type="submit"
                class="rounded-md border border-line px-4 py-2 text-xs font-medium uppercase tracking-wider text-muted hover:border-brand"
              >
                {t('adminOrders.refunds.syncTotal')}
              </button>
            </div>
            <p class="text-xs text-muted">
              <Fragment set:html={th('adminOrders.refunds.syncHelp')} />
            </p>
          </form>
        )}
      </div>
    )
  }
</section>
